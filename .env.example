# Optional: npm run login fills TradingView's visible login form from these.
# Complete CAPTCHA/2FA and submit the login form yourself in the Chrome window.
TRADINGVIEW_USERNAME=
TRADINGVIEW_PASSWORD=

# Optional override. Normally npm run login saves cookies in .auth/session.json.
TRADINGVIEW_SESSION=
TRADINGVIEW_SESSION_SIGN=

# Optional: use an existing Chrome executable instead of Puppeteer's download.
# PUPPETEER_EXECUTABLE_PATH=/opt/google/chrome/chrome

# Google Sheets config (same variable names as go-charting-scraper).
# ID or full https://docs.google.com/spreadsheets/d/.../edit URL.
# Once set, snapshot/watch/login read the config tab automatically.
GOOGLE_SHEET_ID=
CONFIG_TAB=config

# Service-account JSON file path or inline JSON. Share the sheet as Editor
# with this account and enable the Google Sheets API in its Cloud project.
# Create a data tab: confirmed Telegram signals append their exact text in A.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternative to the JSON file:
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Signal alerts: one bot and destination. Start the bot in Telegram first,
# or add it to the target group/channel with permission to send messages.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Monitoring window in IST, 24-hour HH:mm format. Restart after changes.
# Defaults: 03:30 AM to 02:00 AM the next day. The trading day resets at open.
# An end earlier than open crosses midnight. Full IST day: 00:00 to 24:00.
DAY_OPEN_TIME=03:30
DAY_END_TIME=02:00

# Session health: authenticated account check every 10 minutes by default.
# A newly saved login is detected within five seconds. Probe failures retry
# after 30 seconds; Telegram notifications still get only one attempt.
SESSION_CHECK_INTERVAL_SECONDS=600

# VPS login portal behind password-protected Nginx HTTPS (public IP or domain).
# Set the URL, then npm run login:proxy generates a private shared proxy token.
# Portal usernames/passwords are stored in Nginx's htpasswd file; see SETUP.md.
LOGIN_PUBLIC_URL=
LOGIN_PROXY_TOKEN=
LOGIN_TIMEOUT_SECONDS=1200
# All three listeners are localhost-only; never open these ports publicly.
LOGIN_PORT=6080
LOGIN_DESKTOP_PORT=6081
LOGIN_VNC_PORT=5901
