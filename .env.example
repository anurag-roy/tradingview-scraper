# Optional: npm run login fills TradingView's visible login form from these.
# Complete CAPTCHA/2FA and submit the login form yourself in the Chrome window.
TRADINGVIEW_USERNAME=
TRADINGVIEW_PASSWORD=

# Optional override. Normally npm run login saves cookies in .auth/session.json.
TRADINGVIEW_SESSION=
TRADINGVIEW_SESSION_SIGN=

# Optional: use an existing Chrome executable instead of Puppeteer's download.
# PUPPETEER_EXECUTABLE_PATH=/opt/google/chrome/chrome

# Google Sheets config (same variable names as go-charting-scraper).
# ID or full https://docs.google.com/spreadsheets/d/.../edit URL.
# Once set, snapshot/watch/login read the config tab automatically.
GOOGLE_SHEET_ID=
CONFIG_TAB=config

# Service-account JSON file path or inline JSON. Share the sheet as Viewer
# with this account and enable the Google Sheets API in its Cloud project.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternative to the JSON file:
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Signal alerts: one bot and destination. Start the bot in Telegram first,
# or add it to the target group/channel with permission to send messages.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Monitoring window in IST, 24-hour HH:mm format. Restart after changes.
# Defaults: 03:30–14:00. For the full IST day use 00:00 and 24:00.
# End must be later than open; overnight windows are not supported.
DAY_OPEN_TIME=03:30
DAY_END_TIME=14:00
